# ===== Server AI proxy — NEVER commit real .env / NEVER put key in VITE_* =====
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
# Locked on server — browsers cannot switch to gpt-4 / expensive models
OPENAI_MODEL=gpt-4o-mini
PORT=8787

# --- Public launch security (recommended) ---
# Your real site origin(s). Do NOT leave * in production.
CORS_ORIGIN=https://your-domain.com

# Optional invite code (users enter once)
SOFT_LAUNCH_CODE=

# Optional app token — same value in VITE_PROXY_APP_TOKEN (blocks casual curl)
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PROXY_APP_TOKEN=

SERVE_STATIC=1

# Daily pack ≈ 7+ AI calls in a row — keep minute/hour high enough
RATE_MINUTE=20
RATE_HOUR=60
RATE_DAY=80
RATE_TUTOR_DAY=40
RATE_LOOKUP_DAY=40
RATE_DAILY_DAY=40
RATE_WEEKLY_DAY=8
RATE_GLOBAL_DAY=2500
RATE_CONCURRENT_IP=3

# Daily/weekly JSON is large — too low = truncated empty pack
MAX_TOKENS_TUTOR=700
MAX_TOKENS_LOOKUP=350
MAX_TOKENS_DAILY=4000
MAX_TOKENS_WEEKLY=4000

# ===== Vite client =====
# VITE_AI_PROXY=0
# VITE_AI_PROXY_URL=/api/ai
# VITE_PROXY_APP_TOKEN=same-as-PROXY_APP_TOKEN
#
# Local:  npm run dev:api   +   npm run dev
# Prod:   npm run build && set SERVE_STATIC=1 && npm start
